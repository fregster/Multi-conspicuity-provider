# Shared by editors and shfmt (which reads its options from here).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md,html}]
indent_size = 2

[*.sh]
switch_case_indent = true
space_redirects = true
