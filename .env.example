# Copy to .env and fill in your own values.

# --- Station ---
TZ=Europe/London
STATION_NAME=my-station
STATION_LAT=51.5074
STATION_LON=-0.1278
STATION_ALT_M=25

# --- SDR assignment ---
# Serial numbers let you pin each service to a specific dongle once you have
# more than one attached (rtl_eeprom -d 0 to read/set a dongle's serial).
# Leave blank while you only have a single dongle.
SDR_1090_SERIAL=
SDR_1090_PPM=0
SDR_FLARM_SERIAL=
SDR_FLARM_PPM=0

# --- ADS-B web UI ---
TAR1090_PORT=8080
# Optional heywhatsthat.com panorama ID: draws the theoretical range outline on
# the map (reveals the exact station location to anyone who can see the map).
HEYWHATSTHAT_PANORAMA_ID=
# Host directory holding the offline basemap (see tiles/offline_tiles.py).
OFFLINE_TILES_DIR=/usr/local/share/osm_tiles_offline

# --- Reverse proxy (external HTTPS access) ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# --- ADS-B aggregators fed directly by ultrafeeder ---
# One UUID per network so they can't link this station to each other. Leave
# them blank: ./init-uuids.sh (also run by deploy.sh) generates any that are
# missing and never changes one that's set. Register adsb.lol's at https://adsb.lol/claim
ADSBLOL_UUID=
ADSBFI_UUID=
AIRPLANESLIVE_UUID=
PLANESPOTTERS_UUID=
ADSBX_UUID=
THEAIRTRAFFIC_UUID=
ADSBWIN_UUID=
HPRADAR_UUID=
FLYITALY_UUID=
ADSBITALIA_UUID=
DATAERO_UUID=
ADSBIQ_UUID=
PLANETRACK_UUID=
AVDELPHI_UUID=
MAPFLIGHTS_UUID=
SKYDEX_UUID=
FLYOVERHEAD_UUID=
REALTRAFFIC_UUID=
FLIGHTDECK_UUID=

# --- Beast Reduce Plus peers ---
# "name,out=host:port,in=host:port,mlat=host:port;..." - out= feeds them our
# data, in= pulls theirs, mlat= runs an MLAT client against their server (results
# shown on /peer-map only, needs the peer-map profile); give any of them. Inbound traffic only appears on the separate
# /peer-map map (never re-fed to the aggregators above) - enable it with
# COMPOSE_PROFILES=peer-map. Each peer must first be given BEAST_PEER_UUID
# (generated by ./init-uuids.sh, shared by all peers).
# Known peers:
#   1090MHz.uk - email the UUID, a 3-12 char station name and contact details
#   to mike.tubby@1090mhz.uk (https://1090mhz.uk/peering.php). Inbound is only
#   enabled while we feed them.
#     1090mhz.uk,out=adsb-in.1090mhz.uk:30004,in=adsb.1090mhz.uk:30005
#   Another station of this stack running as a hub (below):
#     hub,out=hub.example.org:30004,in=hub.example.org:30005,mlat=hub.example.org:31090
BEAST_PEERS=
BEAST_PEER_UUID=
#COMPOSE_PROFILES=peer-map

# --- Hub: let other stations of this stack peer with us ---
# COMPOSE_PROFILES=hub (implies peer-map) publishes peer-map's Beast input and
# output and an MLAT server for the group, then run ./hub/ufw.sh on the host to
# open the ports. Join our own MLAT with BEAST_PEERS=self,mlat=mlat-server:31090.
# Peers' traffic still only reaches /peer-map, never the aggregators.
#COMPOSE_PROFILES=hub
#HUB_BEAST_IN_PORT=30004
#HUB_BEAST_OUT_PORT=30005
#HUB_MLAT_PORT=31090
# Only these peers' BEAST_PEER_UUIDs may feed us or use the MLAT server
# (comma-separated; blank = anyone who can reach the ports).
#HUB_ALLOWED_UUIDS=
# Source IPs/CIDRs hub/ufw.sh lets in (comma-separated; blank = anywhere).
# The only limit on the Beast output port, as readers send no UUID.
#HUB_ALLOWED_SOURCES=

# --- ADS-B aggregators with their own client container ---
# PiAware: your FlightAware feeder ID, from https://flightaware.com/adsb/piaware/claim
PIAWARE_FEEDER_ID=
# ADSBHub: station key from https://www.adsbhub.org/howtofeed.php
ADSBHUB_CLIENTKEY=
# FlightRadar24: sharing key from https://www.flightradar24.com/share-your-data
FR24_SHARING_KEY=
# FR24 MLAT is off by default (FR24's request for multi-aggregator stations); yes to enable
FR24_MLAT=no
# RadarBox/AirNav Radar: sharing key from your airnavradar.com account
RADARBOX_SHARING_KEY=
# OpenSky Network: your account username and the feeder serial registered at https://opensky-network.org/my-opensky
OPENSKY_USERNAME=
OPENSKY_SERIAL=
# PlaneFinder: share code from https://data.planefinder.net
PLANEFINDER_SHARECODE=

# --- FLARM/OGN ---
# Receiver callsign, max 9 chars: http://wiki.glidernet.org/receiver-naming-convention
OGN_CALLSIGN=
OGN_RF_STATUS_PORT=8081
OGN_DECODE_STATUS_PORT=8082
# Radius (km) of OGN network traffic to pull onto the tar1090 map via ogn-bridge
OGN_RANGE_KM=150

# --- Image tags (optional) ---
# sdr-enthusiasts images track :latest unless pinned here. To pin, set a tag or
# a digest from https://github.com/orgs/sdr-enthusiasts/packages, e.g.
# ULTRAFEEDER_TAG=latest@sha256:<digest>
ULTRAFEEDER_TAG=
PIAWARE_TAG=
ADSBHUB_TAG=
FR24_TAG=
AIRNAVRADAR_TAG=
OPENSKY_TAG=
PLANEFINDER_TAG=

# --- Remote deploy target (used by deploy.sh only, not Docker Compose) ---
PI_HOST=
PI_USER=
