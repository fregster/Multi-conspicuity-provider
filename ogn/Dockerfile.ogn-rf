# RF front-end: reads a 868.8MHz RTL-SDR, streams demodulated spectra to ogn-decode
# over TCP port 50010. ogn-rf is open source (glidernet/ogn-rf); we use the official
# precompiled arm64 binary rather than rebuilding from source.
FROM debian:trixie-slim AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN wget --no-check-certificate -qO- http://download.glidernet.org/arm64/rtlsdr-ogn-bin-arm64-latest.tgz | tar xz -C /tmp && \
    mkdir -p /out && cp /tmp/rtlsdr-ogn/ogn-rf /out/ogn-rf

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      librtlsdr0 libpng16-16 gettext-base && \
    rm -rf /var/lib/apt/lists/*
COPY --from=fetch /out/ogn-rf /usr/local/bin/ogn-rf
COPY rtlsdr-ogn.conf.template /ogn/rtlsdr-ogn.conf.template
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /ogn
EXPOSE 8080 50010
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ogn-rf", "/ogn/rtlsdr-ogn.conf"]
