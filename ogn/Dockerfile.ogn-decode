# Decoder: reads demodulated spectra from ogn-rf over TCP and pushes decoded
# FLARM/OGN positions to the Open Glider Network APRS server. ogn-decode is
# closed-source freeware distributed only as a precompiled binary by glidernet.
FROM debian:trixie-slim AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN wget --no-check-certificate -qO- http://download.glidernet.org/arm64/rtlsdr-ogn-bin-arm64-latest.tgz | tar xz -C /tmp && \
    mkdir -p /out && cp /tmp/rtlsdr-ogn/ogn-decode /out/ogn-decode

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpng16-16 gettext-base && \
    rm -rf /var/lib/apt/lists/*
COPY --from=fetch /out/ogn-decode /usr/local/bin/ogn-decode
COPY rtlsdr-ogn.conf.template /ogn/rtlsdr-ogn.conf.template
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /ogn
EXPOSE 8081
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ogn-decode", "/ogn/rtlsdr-ogn.conf"]
