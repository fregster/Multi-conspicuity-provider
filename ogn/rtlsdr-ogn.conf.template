# Rendered to rtlsdr-ogn.conf at container start (see entrypoint.sh).
# Shared by both ogn-rf and ogn-decode - each only reads the sections it needs.
# Reference: https://github.com/glidernet/ogn-rf (libconfig syntax)

RF:
{
  FreqCorr = ${SDR_FLARM_PPM};
  DeviceSerial = "${SDR_FLARM_SERIAL}";
  OGN:
  {
    CenterFreq = 868.8;
    Gain = 49.6;
  };
};

Demodulator:
{
  PipeName = "ogn-rf:50010";
};

Position:
{
  Latitude  = ${STATION_LAT};
  Longitude = ${STATION_LON};
  Altitude  = ${STATION_ALT_M};
};

APRS:
{
  Call = "${OGN_CALLSIGN}";
  # Not the OGN network directly: ogn-bridge is a local APRS endpoint that feeds
  # our own positions to tar1090 (works offline) and relays them to
  # aprs.glidernet.org whenever the internet is reachable.
  Server = "ogn-bridge:14580";
};
